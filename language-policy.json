  "scan": {
    "directories": ["src", "docs", "public", "tests", "dist"],
    "files": ["index.html", "package.json", "guide.manifest.json", "deliverables.registry.json"],
    "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".css", ".html", ".md", ".json", ".sql", ".mmd", ".txt", ".py"],
    "ignoredDirectories": ["node_modules", ".git", ".pytest_cache", ".codex"],
    "ignoredFiles": ["language-policy.json", "scripts/validate-language.mjs"]
