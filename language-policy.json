{
  "locale": "es-CO",
  "blockedPatterns": [
    {
      "id": "termino-vetado-01",
      "pattern": "(?<![\\p{L}\\p{N}_-])[dD][oO][sS]{1,2}[iI][eE][rR](?![\\p{L}\\p{N}_-])",
      "message": "Usa «Portafolio de Evidencias», «Expediente», «Informe» o «Registro Integral de Evidencias»."
    },
    {
      "id": "locale-no-colombia",
      "pattern": "(?<![\\p{L}\\p{N}_-])[eE][sS][-_][eE][sS](?![\\p{L}\\p{N}_-])",
      "message": "La interfaz y la documentación deben declarar y usar es-CO."
    }
  ],
